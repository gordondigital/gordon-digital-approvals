# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the app, no trailing slash
APP_URL=https://approvals.gordondigital.com.au

# Long random string used to sign reviewer cookies (openssl rand -base64 48)
REVIEW_SECRET=

# Team sign in: Google accounts on these domains or addresses can use the portal
TEAM_EMAIL_DOMAINS=gordondigital.com.au
TEAM_EMAILS=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Gordon Digital Approvals <approvals@notify.gordondigital.com.au>"
EMAIL_REPLY_TO=hello@gordondigital.com.au

# Vercel cron calls /api/cron/reminders with this as a Bearer token
CRON_SECRET=
